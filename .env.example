# Copia este archivo como .env y rellena los valores.
#   cp .env.example .env
# En Portainer no hace falta el archivo: mete estas mismas variables
# en la seccion "Environment variables" del stack.

# ── Obligatorias ──────────────────────────────────────────────────────────
# El stack NO arranca si falta alguna de estas.

# Password de PostgreSQL
POSTGRES_PASSWORD=pon_aqui_una_password_segura

# Credenciales del panel de administracion
ADMIN_USER=admin
ADMIN_PASSWORD=pon_aqui_una_password_segura

# Secreto para firmar las cookies de sesion.
# Genera uno con:  openssl rand -hex 32
SESSION_SECRET=pon_aqui_64_caracteres_hex_aleatorios

# ── Opcionales (tienen default) ───────────────────────────────────────────

# Puerto publico del panel + endpoint de ingesta
PORT=4000

# Dias que se conservan los eventos crudos antes de purgarse.
# Los agregados diarios (feature_daily) no se purgan nunca.
RETENTION_DAYS=365

# true → la IP se trunca a /24 (IPv4) o /48 (IPv6) antes de guardarse.
# false → se guarda la IP completa.
ANONYMIZE_IP=false

# true si el servicio va detras de un reverse proxy (lee X-Forwarded-For).
# Dejar en false si se expone el puerto directo, o cualquiera podra
# falsear su IP con una cabecera.
TRUST_PROXY=false

# Zona horaria para el corte de dia de los graficos.
TZ=America/Guayaquil
TZ_DISPLAY=America/Guayaquil

# Origenes permitidos para /api/public/* (la web donde incrustas los
# creadores), separados por coma. Cada entrada admite un unico comodin "*"
# (util para hashes de preview de Vercel). "*" a secas permite cualquiera.
# Ejemplo con apex + www + rama + previews de un proyecto de Vercel:
PUBLIC_ORIGIN=https://www.tiklivetts.es,https://tiklivetts.es,https://tiktok-tts-landing-git-main-luisleonpardos-projects.vercel.app,https://tiktok-tts-landing-*-luisleonpardos-projects.vercel.app
